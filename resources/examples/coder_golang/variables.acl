variable "agents" {
  type = map(object({
    provider          = string
    model             = string
    thinking          = string
    image             = string
    context_window    = number
    max_output_tokens = number
    reasoning         = bool
  }))
  description = "Per-Agent settings keyed by specification, planning, build, and review. An empty image selects globals.image explicitly in agents.acl."
}

variable "globals" {
  type        = object({ image = string })
  description = "Shared image for Agents whose image setting is empty."
}

variable "providers" {
  type = map(object({
    api         = string
    api_key_env = string
    base_url    = string
  }))
  description = "Named provider profiles. Each profile keeps its protocol, endpoint, and credential source together."
}
