package "provider" {
  version = "0.1.0"
}

variable "profiles" {
  type = map(object({
    api         = string
    api_key_env = string
    base_url    = string
  }))
  description = "Named provider profiles whose credentials are supplied by the worker environment."
}

secret "credentials" {
  env = { for name, profile in var.profiles : name => profile.api_key_env }
}

output "credentials" {
  value = secret.credentials
}
