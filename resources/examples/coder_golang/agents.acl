agent "specification" {
  identity   = "watts-agent"
  config_ref = module.provider.outputs.defaults.name
  prompt     = file("prompts/specification.md")
  inputs     = ["SPEC.md"]
  outputs    = ["SPEC.md"]
  environment = {
    GOCACHE    = "/runtime/go-cache"
    GOMODCACHE = "/runtime/go-mod"
  }

  container {
    image     = var.image
    command   = ["node", "/opt/watts/launcher.mjs"]
    workspace = "read-only"
    network   = "bridge"
    memory_mb = 4096
    cpus      = 2
    files = {
      "launcher.json" = jsonencode({ outputs = ["SPEC.md"] })
    }
    resources = {
      team = package.root
    }
  }

  skill "watts-guidance" {
    source {
      image_path = "/opt/watts/kit/skills"
    }
  }

  skill "go-team-guidance" {
    source {
      resource = "team"
      path     = "skills"
    }
  }

  tool "check-spec" {
    description = "Validate the task spec artifact."

    command {
      argv            = ["node", "/inputs/resources/team/scripts/check.mjs", "spec", "/runtime/task"]
      working_dir     = "/runtime/task"
      timeout_seconds = 30
    }
  }

  gate "spec-valid" {
    tool = "check-spec"

    expect {
      exit_code = 0
    }
  }
}

agent "planning" {
  identity   = "watts-agent"
