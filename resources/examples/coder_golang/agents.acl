agent "specification" {
  identity   = "watts-agent"
  provider   = var.agents.specification.provider
  model      = var.agents.specification.model
  thinking   = var.agents.specification.thinking
  base_url   = var.providers[var.agents.specification.provider].base_url
  api        = var.providers[var.agents.specification.provider].api

  auth {
    env    = var.providers[var.agents.specification.provider].api_key_env
    secret = module.provider.outputs.credentials.keys[var.agents.specification.provider]
  }
  prompt     = file("prompts/specification.md")
  inputs     = ["SPEC.md"]
  outputs    = ["SPEC.md"]
  environment = {
    GOCACHE    = "/runtime/go-cache"
    GOMODCACHE = "/runtime/go-mod"
  }

  container {
    image     = var.agents.specification.image != "" ? var.agents.specification.image : var.globals.image
    command   = ["node", "/opt/watts/launcher.mjs"]
    workspace = "read-only"
    network   = "bridge"
    memory_mb = 4096
    cpus      = 2
    files = {
      "launcher.json" = jsonencode({
        outputs = ["SPEC.md"]
        model_config = {
          contextWindow = var.agents.specification.context_window
          maxTokens     = var.agents.specification.max_output_tokens
          reasoning     = var.agents.specification.reasoning
        }
      })
    }
    resources = {
      team = package.root
    }
  }

  skill "watts-guidance" {
    source {
      image_path = "/opt/watts/kit/skills"
    }
  }

  skill "go-team-guidance" {
    source {
      resource = "team"
      path     = "skills"
    }
  }

  tool "check-spec" {
    description = "Validate the task spec artifact."

    command {
      argv            = ["node", "/inputs/resources/team/scripts/check.mjs", "spec", "/runtime/task"]
      working_dir     = "/runtime/task"
      timeout_seconds = 30
    }
  }

  gate "spec-valid" {
    tool = "check-spec"

    expect {
      exit_code = 0
    }
  }
}

