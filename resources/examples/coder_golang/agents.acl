agent "build" {
  identity   = "watts-agent"
  provider   = var.agents.build.provider
  model      = var.agents.build.model
  thinking   = var.agents.build.thinking
  base_url   = var.providers[var.agents.build.provider].base_url
  api        = var.providers[var.agents.build.provider].api

  auth {
    env    = var.providers[var.agents.build.provider].api_key_env
    secret = module.provider.outputs.credentials.keys[var.agents.build.provider]
  }
  prompt     = file("prompts/build.md")
  inputs     = ["SPEC.md", "PLAN.md"]
  outputs    = ["STORY_LOG.md"]
  environment = {
    GOCACHE    = "/runtime/go-cache"
    GOMODCACHE = "/runtime/go-mod"
  }

  container {
    image     = var.agents.build.image != "" ? var.agents.build.image : var.globals.image
    command   = ["node", "/opt/watts/launcher.mjs"]
    workspace = "write"
    network   = "bridge"
    memory_mb = 4096
    cpus      = 2
    files = {
      "launcher.json" = jsonencode({
        model_config = {
          contextWindow = var.agents.build.context_window
          maxTokens     = var.agents.build.max_output_tokens
          reasoning     = var.agents.build.reasoning
        }
        outputs = ["STORY_LOG.md"]
        ralph   = true
      })
      "ralph.md" = file("prompts/build-ralph.md")
    }
    resources = {
      team = package.root
    }
  }

  skill "watts-guidance" {
    source {
      image_path = "/opt/watts/kit/skills"
    }
  }

  skill "go-team-guidance" {
    source {
      resource = "team"
      path     = "skills"
    }
  }

  tool "build" {
    description = "Compile the project into private runtime storage."
    command     = module.go-tools.outputs.build
  }

  tool "test" {
    description = "Run the project Go tests."
    command     = module.go-tools.outputs.test
  }

  tool "vet" {
    description = "Run Go vet static analysis."
    command     = module.go-tools.outputs.vet
  }

  tool "lint" {
    description = "Check the project against team lint policy."
    command     = module.go-tools.outputs.lint
  }

  tool "code-intelligence" {
    mcp {
      ref      = module.gopls.outputs.service.name
      exposure = "deferred"
    }
  }

  tool "check-stories" {
    description = "Validate the task stories artifact."

    command {
      argv            = ["node", "/inputs/resources/team/scripts/check.mjs", "stories", "/runtime/task"]
      working_dir     = "/runtime/task"
      timeout_seconds = 30
    }
  }

  gate "build-passes" {
    tool = "build"

    expect {
      exit_code = 0
    }
  }

  gate "test-passes" {
    tool = "test"

    expect {
      exit_code = 0
    }
  }

  gate "vet-passes" {
    tool = "vet"

    expect {
      exit_code = 0
    }
  }

  gate "lint-passes" {
    tool = "lint"

    expect {
      exit_code = 0
    }
  }

  gate "stories-complete" {
    tool = "check-stories"

    expect {
      exit_code = 0
    }
  }

  gate_policy {
    max_repairs = 2
  }
}

agent "review" {
  identity   = "watts-reviewer"
  provider   = var.agents.review.provider
  model      = var.agents.review.model
  thinking   = var.agents.review.thinking
  base_url   = var.providers[var.agents.review.provider].base_url
  api        = var.providers[var.agents.review.provider].api

  auth {
    env    = var.providers[var.agents.review.provider].api_key_env
    secret = module.provider.outputs.credentials.keys[var.agents.review.provider]
  }
  prompt     = file("prompts/review.md")
  inputs     = ["SPEC.md", "PLAN.md", "STORY_LOG.md"]
  outputs    = ["review/VERDICT.md"]
  environment = {
    GOCACHE    = "/runtime/go-cache"
    GOMODCACHE = "/runtime/go-mod"
  }

  container {
    image     = var.agents.review.image != "" ? var.agents.review.image : var.globals.image
    command   = ["node", "/opt/watts/launcher.mjs"]
    workspace = "read-only"
    network   = "bridge"
    memory_mb = 4096
    cpus      = 2
    files = {
      "launcher.json" = jsonencode({
        model_config = {
          contextWindow = var.agents.review.context_window
          maxTokens     = var.agents.review.max_output_tokens
          reasoning     = var.agents.review.reasoning
        }
        outputs = ["review/VERDICT.md"]
        ralph   = true
        verdict = "review/VERDICT.md"
      })
      "ralph.md" = file("prompts/review-ralph.md")
    }
    resources = {
      team = package.root
    }
  }

  skill "watts-guidance" {
    source {
      image_path = "/opt/watts/kit/skills"
    }
  }

  skill "go-team-guidance" {
    source {
      resource = "team"
      path     = "skills"
    }
  }

  tool "test" {
    description = "Run the project Go tests."
    command     = module.go-tools.outputs.test
  }

  tool "vet" {
    description = "Run Go vet static analysis."
    command     = module.go-tools.outputs.vet
  }

  tool "lint" {
    description = "Check the project against team lint policy."
    command     = module.go-tools.outputs.lint
  }

  tool "verify-verdict" {
    description = "Validate the review verdict artifact; PASS and REJECT are both valid decisions."

    command {
      argv            = ["node", "/inputs/resources/team/scripts/check.mjs", "verdict", "/runtime/task"]
      working_dir     = "/runtime/task"
      timeout_seconds = 30
    }
  }

  gate "verdict-valid" {
    tool = "verify-verdict"

    expect {
      exit_code = 0
    }
  }

  gate_policy {
    max_repairs = 0
  }
}
