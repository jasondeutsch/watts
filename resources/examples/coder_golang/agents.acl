  inputs     = ["SPEC.md"]
  outputs    = ["PLAN.md"]
  environment = {
    GOCACHE    = "/runtime/go-cache"
    GOMODCACHE = "/runtime/go-mod"
  }

  container {
    image     = var.image
    command   = ["node", "/opt/watts/launcher.mjs"]
    workspace = "read-only"
    network   = "bridge"
    memory_mb = 4096
    cpus      = 2
    files = {
      "launcher.json" = jsonencode({ outputs = ["PLAN.md"] })
    }
    resources = {
      team = package.root
    }
  }

  skill "watts-guidance" {
    source {
      image_path = "/opt/watts/kit/skills"
    }
  }

  skill "go-team-guidance" {
    source {
      resource = "team"
