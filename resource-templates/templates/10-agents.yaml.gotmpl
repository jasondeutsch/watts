{{ range $name, $settings := (get .Values "agents" | default dict) }}
---
kind: Agent
schema_version: 1
name: {{ $name | quote }}
spec:
{{ if hasKey $settings "config_ref" }}
  config_ref: {{ $settings.config_ref | quote }}
{{ end }}
{{ if hasKey $settings "identity" }}
  identity: {{ $settings.identity | quote }}
{{ end }}
{{ if hasKey $settings "provider" }}
  provider: {{ $settings.provider | quote }}
{{ end }}
{{ if hasKey $settings "model" }}
  model: {{ $settings.model | quote }}
{{ end }}
{{ if hasKey $settings "prompt" }}
  prompt: {{ $settings.prompt | quote }}
{{ end }}
{{ if hasKey $settings "base_url" }}
  base_url: {{ $settings.base_url | quote }}
{{ end }}
{{ if hasKey $settings "api" }}
  api: {{ $settings.api | quote }}
{{ end }}
{{ if hasKey $settings "thinking" }}
  thinking: {{ $settings.thinking | quote }}
{{ end }}
{{ if hasKey $settings "skills_dirs" }}
  skills_dirs: {{ $settings.skills_dirs | toYaml | nindent 4 }}
{{ end }}
{{ with (get $settings "auth") }}
  auth:
    env: {{ .env | quote }}
    secret:
      name: {{ .secret.name | quote }}
      key: {{ .secret.key | quote }}
{{ end }}
{{ template "watts.agent-capabilities" $settings }}
{{ template "watts.contract" $settings }}
{{ end }}
