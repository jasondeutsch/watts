{{ range $name, $settings := (get .Values "agents" | default dict) }}
---
kind: Agent
schema_version: 1
name: {{ $name | quote }}
spec:
{{ if hasKey $settings "config_ref" }}
  config_ref: {{ $settings.config_ref | quote }}
{{ end }}
{{ if hasKey $settings "runtime_agent" }}
  runtime_agent: {{ $settings.runtime_agent | quote }}
{{ end }}
{{ if hasKey $settings "runtime" }}
  runtime: {{ $settings.runtime | quote }}
{{ end }}
{{ if hasKey $settings "identity" }}
  identity: {{ $settings.identity | quote }}
{{ end }}
{{ if hasKey $settings "provider" }}
  provider: {{ $settings.provider | quote }}
{{ end }}
{{ if hasKey $settings "model" }}
  model: {{ $settings.model | quote }}
{{ end }}
{{ if hasKey $settings "prompt" }}
  prompt: {{ $settings.prompt | quote }}
{{ end }}
{{ if hasKey $settings "base_url" }}
  base_url: {{ $settings.base_url | quote }}
{{ end }}
{{ if hasKey $settings "api" }}
  api: {{ $settings.api | quote }}
{{ end }}
{{ if hasKey $settings "thinking" }}
  thinking: {{ $settings.thinking | quote }}
{{ end }}
{{ if hasKey $settings "skills_dirs" }}
  skills_dirs: {{ $settings.skills_dirs | toYaml | nindent 4 }}
{{ end }}
{{ if hasKey $settings "mcps" }}
  mcps: {{ $settings.mcps | toYaml | nindent 4 }}
{{ end }}
{{ with (get $settings "sandbox") }}
  sandbox:
    mode: {{ .mode | quote }}
{{ end }}
{{ with (get $settings "auth") }}
  auth:
    env: {{ .env | quote }}
    secret:
      name: {{ .secret.name | quote }}
      key: {{ .secret.key | quote }}
{{ end }}
{{ with (get $settings "mcp_servers") }}
  mcp_servers:
{{ range $serverName, $server := . }}
    {{ $serverName | quote }}:
{{ if hasKey $server "command" }}
      command: {{ $server.command | quote }}
{{ end }}
{{ if hasKey $server "url" }}
      url: {{ $server.url | quote }}
{{ end }}
{{ if hasKey $server "cwd" }}
      cwd: {{ $server.cwd | quote }}
{{ end }}
{{ if hasKey $server "exposure" }}
      exposure: {{ $server.exposure | quote }}
{{ end }}
{{ if hasKey $server "description" }}
      description: {{ $server.description | quote }}
{{ end }}
{{ if hasKey $server "args" }}
      args: {{ $server.args | toYaml | nindent 8 }}
{{ end }}
{{ if hasKey $server "env" }}
      env: {{ $server.env | toYaml | nindent 8 }}
{{ end }}
{{ if hasKey $server "headers" }}
      headers: {{ $server.headers | toYaml | nindent 8 }}
{{ end }}
{{ end }}
{{ end }}
{{ template "watts.contract" $settings }}
{{ end }}
