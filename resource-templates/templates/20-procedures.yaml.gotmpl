{{ range $name, $settings := (get .Values "procedures" | default dict) }}
---
kind: Procedure
schema_version: 1
name: {{ $name | quote }}
spec:
{{ if hasKey $settings "config_ref" }}
  config_ref: {{ $settings.config_ref | quote }}
{{ end }}
  execution:
    type: {{ $settings.execution.type | quote }}
{{ if hasKey $settings.execution "command" }}
    command: {{ $settings.execution.command | quote }}
{{ end }}
{{ if hasKey $settings.execution "check" }}
    check: {{ $settings.execution.check | quote }}
{{ end }}
{{ if hasKey $settings.execution "capability" }}
    capability: {{ $settings.execution.capability | quote }}
{{ end }}
{{ if hasKey $settings.execution "args" }}
    args: {{ $settings.execution.args | toYaml | nindent 6 }}
{{ end }}
{{ if hasKey $settings.execution "argv" }}
    argv: {{ $settings.execution.argv | toYaml | nindent 6 }}
{{ end }}
{{ template "watts.contract" $settings }}
{{ end }}
